# Frontend: Next.js
# Backend: WordPress with functions.php

# Public WordPress site URL used by the frontend integration.
NEXT_PUBLIC_WORDPRESS_URL=https://your-wordpress-site.example.com

# WordPress pages containing the PHP shortcodes/forms.
NEXT_PUBLIC_WORDPRESS_QUOTE_PATH=/quote/
NEXT_PUBLIC_WORDPRESS_CONTACT_PATH=/contact/

# Recipient for quote and contact form email submissions.
NEXT_PUBLIC_FORM_EMAIL=Jardinetechnologies@gmail.com

# Set to wordpress when the frontend form adapter is connected to functions.php.
# The current frontend still uses FormSubmit until that adapter is configured.
NEXT_PUBLIC_BACKEND=wordpress

# Set to 1 only for a static preview hosted under a nested URL prefix.
PREVIEW_RELATIVE=0
